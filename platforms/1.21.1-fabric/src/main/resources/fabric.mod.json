{
  "schemaVersion": 1,
  "id": "mcphone",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "把一部能用的智能手机塞进 Minecraft —— 拍照、翻相册、换壁纸、听歌、装 App，还能给自己那一部手机起个名。App 系统通过 SPI 开放，附属模组无需被本模组感知即可注册自己的 App。\n\nA working smartphone in Minecraft: camera, gallery, custom wallpapers, a music player, and an open SPI-based app system that add-on mods can plug into.",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_repo_url}",
    "issues": "${mod_repo_url}/issues",
    "sources": "${mod_repo_url}"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.november.mcphone.MCphone"
    ],
    "client": [
      "com.november.mcphone.MCphoneClient"
    ]
  },
  "mixins": [
    "mcphone.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "curios": "*",
    "waystones": "*",
    "balm": "*",
    "mcef": "*",
    "net-music": "*",
    "patchouli": "*"
  }
}
